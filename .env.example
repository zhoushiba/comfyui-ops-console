# ===== 服务端（apps/server） =====
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# 数据库：sqlite（默认，零依赖）| mysql | pg
DB_CLIENT=sqlite
# sqlite 文件路径（相对 apps/server 或绝对路径）
DB_FILENAME=./data/app.db
# 生产示例（需先创建数据库并执行 db/schema.mysql.sql 或 knex migrate）
# DATABASE_URL=mysql://ops:ops_password@127.0.0.1:3306/comfyui_ops

# ComfyUI 服务地址（mock 默认 8188）
COMFYUI_BASE_URL=http://127.0.0.1:8188
# 单次 HTTP 请求超时（毫秒）
COMFYUI_REQUEST_TIMEOUT_MS=10000
# 轮询间隔（毫秒）
COMFYUI_POLL_INTERVAL_MS=800
# 任务总超时（毫秒），超过置为 timeout
COMFYUI_JOB_TIMEOUT_MS=60000
# 失败重试上限（指数退避：1s, 2s, 4s ...）
COMFYUI_MAX_RETRIES=3
# 编排并发数
ORCHESTRATOR_CONCURRENCY=2

# 图片存储目录（相对 apps/server）
STORAGE_DIR=./storage
# 自动生成的缩略图边长
THUMBNAIL_SIZE=256

# 登录令牌签名密钥（生产务必替换）
JWT_SECRET=dev-only-change-me-in-production
# 登录令牌有效期（秒）
TOKEN_TTL_SECONDS=43200

# 结算：平台分成比例（0.2 表示平台抽 20%）
PLATFORM_FEE_RATIO=0.2

# ===== ComfyUI Mock（services/comfyui-mock） =====
MOCK_PORT=8188
# ok | slow | fail | partial（dead 需通过管理接口切换：关闭监听端口）
MOCK_MODE=ok
# slow 模式每次请求延迟（毫秒）
MOCK_SLOW_MS=5000
# 任务模拟总耗时（毫秒），用于观察 0→100% 进度
MOCK_JOB_DURATION_MS=3000

# ===== 前端（apps/web） =====
# 前端请求的后端地址；留空则走 Vite 代理 /api -> http://127.0.0.1:3000
VITE_API_BASE_URL=
